# Copy to .env (never commit .env)
OPENROUTER_API_KEY=sk-or-...
# Supabase: Connect -> Session pooler -> URI (replace [YOUR-PASSWORD])
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
EMBED_MODEL=openai/text-embedding-3-small

# Lesson 3: the answer-writing model (copy the id and prices from openrouter.ai/models)
CHAT_MODEL=anthropic/claude-haiku-5.5
CHAT_IN_PRICE=0.10
CHAT_OUT_PRICE=0.50
